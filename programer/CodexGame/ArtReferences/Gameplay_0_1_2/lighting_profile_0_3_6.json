    "color": "#B8753F",
    "purpose": "Reveal walls, floor, chairs, shelves and bottles"
  },
  "leftPractical": {
    "intensityRelativeToTableKey": 0.18,
    "color": "#D9954F",
    "target": "bar shelves and bottles"
  },
  "rightPractical": {
    "intensityRelativeToTableKey": 0.15,
    "color": "#C47B42",
    "target": "frames, stairs and chairs"
  },
  "qa": {
    "backgroundMustBeMoreThanSilhouette": true,
    "cardsAndUiUnaffectedByWorldLight": true,
    "retainDarkWesternMood": true
  }
