{
  "version": "0.3.6",
  "intent": "Readable warm western saloon while preserving the table as the focal point",
  "tableKey": {
    "type": "Spot Light",
    "intensityMultiplierFromCurrent": 1.20,
    "color": "#FFD08A",
    "fixtureVisible": false
  },
  "saloonFill": {
    "type": "wide Area Light or broad Spot Light",
